local function trim(s)
    return (s:gsub("^%s*(.-)%s*$", "%1"))
end

local userKey = trim(tostring(rawKey))

if userKey == "" or userKey == "nil" then
    LocalPlayer:Kick("[PJHub] Nenhuma Key informada! Defina _G.PJHUB_KEY antes do loadstring.")
    return
end

local function validateKey(keyToTest)
    local reqFunc = (syn and syn.request) or (http and http.request) or http_request or request
    if not reqFunc then return false, "Executor sem suporte HTTP." end

    local userId = tostring(LocalPlayer.UserId)

    local success, response = pcall(function()
        return reqFunc({
            Url = PANEL_URL .. "/api/validate?key=" .. HttpService:UrlEncode(keyToTest) .. "&userId=" .. HttpService:UrlEncode(userId),
            Method = "GET",
            Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/PJHub" }
        })
    end)

    if success and response then
        local statusCode = response.StatusCode or response.Status
        if statusCode == 200 then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if decodeSuccess and data and data.valid then return true, "OK" end
            return false, (data and data.message) or "Key invalida."
        end
        return false, "Erro no servidor (Status " .. tostring(statusCode) .. ")"
    end
    return false, "Servidor indisponivel."
end

local isValid, errorMsg = validateKey(userKey)
if not isValid then
    LocalPlayer:Kick("[PJHub] Falha na Autenticacao: " .. tostring(errorMsg))
    return
end

task.spawn(function()
