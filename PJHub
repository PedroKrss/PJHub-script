local botoesCriados = {}

local function criarBotao(nome, texto, acao, isToggle)
    local botao = Instance.new("TextButton")
    botao.Name = nome
    botao.Parent = MainFrame
    botao.BackgroundColor3 = Color3.fromRGB(12, 8, 20)
    botao.BorderSizePixel = 0
    botao.TextColor3 = Color3.fromRGB(200, 160, 255)
    botao.TextSize = 12
    botao.Font = Enum.Font.SourceSansBold
    botao.ClipsDescendants = true
    botao.TextWrapped = true
    botao.ZIndex = 3

    table.insert(botoesCriados, botao)

    if isToggle then botao.Text = texto .. " OFF" else botao.Text = texto end

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 12)
    btnCorner.Parent = botao

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Parent = botao
    btnStroke.Color = Color3.fromRGB(90, 0, 150)
    btnStroke.Thickness = 1.5

    local progressBar = nil
    if isToggle then
        progressBar = Instance.new("Frame")
        progressBar.Name = "ProgressBar"
        progressBar.Parent = botao
        progressBar.Size = UDim2.new(0, 0, 0, 3)
        progressBar.Position = UDim2.new(0, 0, 1, -3)
        progressBar.BackgroundColor3 = Color3.fromRGB(200, 80, 255)
        progressBar.BorderSizePixel = 0
        local progressCorner = Instance.new("UICorner")
        progressCorner.CornerRadius = UDim.new(0, 10)
        progressCorner.Parent = progressBar
    end

    local function pulsar()
        local tOriginal = botao.Size
        local tPulso = UDim2.new(tOriginal.X.Scale, tOriginal.X.Offset + 6, tOriginal.Y.Scale, tOriginal.Y.Offset - 2)
        local info = TweenInfo.new(0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(botao, info, {Size = tPulso}):Play()
        task.wait(0.1)
        TweenService:Create(botao, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = tOriginal}):Play()
    end

    if isToggle then
        local enabled = false
        botao.MouseButton1Click:Connect(function()
            pulsar()
            enabled = not enabled
            local infoCor = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            if enabled then
                TweenService:Create(botao, infoCor, {BackgroundColor3 = Color3.fromRGB(130, 0, 210)}):Play()
                TweenService:Create(btnStroke, infoCor, {Color = Color3.fromRGB(200, 80, 255)}):Play()
                TweenService:Create(botao, infoCor, {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                progressBar.Size = UDim2.new(0, 0, 0, 3)
                TweenService:Create(progressBar, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 3)}):Play()
                botao.Text = texto .. " ON"
            else
                TweenService:Create(botao, infoCor, {BackgroundColor3 = Color3.fromRGB(12, 8, 20)}):Play()
                TweenService:Create(btnStroke, infoCor, {Color = Color3.fromRGB(90, 0, 150)}):Play()
                TweenService:Create(botao, infoCor, {TextColor3 = Color3.fromRGB(200, 160, 255)}):Play()
                TweenService:Create(progressBar, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 0, 0, 3)}):Play()
                botao.Text = texto .. " OFF"
            end
            acao(enabled)
        end)
    else
        botao.MouseButton1Click:Connect(function()
            pulsar()
            local infoCor = TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            TweenService:Create(botao, infoCor, {BackgroundColor3 = Color3.fromRGB(130, 0, 210), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(btnStroke, infoCor, {Color = Color3.fromRGB(200, 80, 255)}):Play()
            acao()
            task.wait(0.25)
            TweenService:Create(botao, infoCor, {BackgroundColor3 = Color3.fromRGB(12, 8, 20), TextColor3 = Color3.fromRGB(200, 160, 255)}):Play()
            TweenService:Create(btnStroke, infoCor, {Color = Color3.fromRGB(90, 0, 150)}):Play()
        end)
    end
end

local function reorganizarBotoes()
    local largura = MainFrame.AbsoluteSize.X
    local colunas
    if largura < 250 then colunas = 1
    elseif largura < 380 then colunas = 2
    else colunas = 3 end

    local margem = 15
    local espaco = 10
    local larguraDisponivel = largura - (margem * 2) - (espaco * (colunas - 1))
    local larguraBotao = larguraDisponivel / colunas
    local alturaBotao = 52

    for i, botao in ipairs(botoesCriados) do
        local col = (i - 1) % colunas
        local row = math.floor((i - 1) / colunas)
        botao.Size = UDim2.new(0, larguraBotao, 0, alturaBotao)
        botao.Position = UDim2.new(0, margem + col * (larguraBotao + espaco), 0, 60 + row * (alturaBotao + espaco))
    end
end

local isResizing = false
local startSize, startMouse

local ResizeIcon = Instance.new("TextButton")
ResizeIcon.Parent = MainFrame
ResizeIcon.Size = UDim2.new(0, 22, 0, 22)
ResizeIcon.Position = UDim2.new(1, -24, 1, -24)
ResizeIcon.BackgroundTransparency = 1
ResizeIcon.Text = "v"
ResizeIcon.TextColor3 = Color3.fromRGB(150, 0, 255)
ResizeIcon.TextSize = 20
ResizeIcon.Font = Enum.Font.SourceSansBold
ResizeIcon.ZIndex = 1000

ResizeIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = true
        MainFrame.Draggable = false
        startSize = MainFrame.Size
        startMouse = input.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startMouse
        local newX = math.clamp(startSize.X.Offset + delta.X, 200, 600)
        local newY = math.clamp(startSize.Y.Offset + delta.Y, 200, 600)
        MainFrame.Size = UDim2.new(0, newX, 0, newY)
        reorganizarBotoes()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = false
        MainFrame.Draggable = true
    end
end)

local janelaAberta = false

local function abrirJanela()
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 380, 0, 220)
    MainFrame.BackgroundTransparency = 1
    MainStroke.Transparency = 1
    Title.TextTransparency = 1
    TitleStroke.Transparency = 1

    local info = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(MainFrame, info, {Size = UDim2.new(0, 420, 0, 260), BackgroundTransparency = 0}):Play()
    TweenService:Create(MainStroke, info, {Transparency = 0}):Play()
    TweenService:Create(Title, info, {TextTransparency = 0}):Play()
    TweenService:Create(TitleStroke, info, {Transparency = 0}):Play()
    task.wait(0.3)
    reorganizarBotoes()
end

local function fecharJanela()
    local info = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    TweenService:Create(MainFrame, info, {Size = UDim2.new(0, 380, 0, 220), BackgroundTransparency = 1}):Play()
    TweenService:Create(MainStroke, info, {Transparency = 1}):Play()
    TweenService:Create(Title, info, {TextTransparency = 1}):Play()
    TweenService:Create(TitleStroke, info, {Transparency = 1}):Play()
    task.wait(0.2)
    MainFrame.Visible = false
end

OpenCircle.MouseButton1Click:Connect(function()
